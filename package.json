{
  "name": "passgen",
  "version": "0.12.0",
  "private": true,
  "type": "module",
  "description": "Policy-compliant password generator and checker: random, passphrase, slang and memorable Polish sentence modes. Runs fully in the browser.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.1.11"
  }
}
